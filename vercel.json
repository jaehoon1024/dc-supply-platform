{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/unpack.mjs",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/api/permits?sync=1",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/address?sync=1",
      "schedule": "0 22 * * *"
    }
  ]
}
